APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DATA_DIR=./data
APP_DB_PATH=./data/app.db
APP_ENABLE_OLLAMA=true
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen3:4b
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
APP_LOG_LEVEL=INFO
APP_API_KEY=
APP_REQUIRE_AUTH_FOR_WRITE=false
MARKET_DATA_PROVIDER_ORDER=twelvedata,alphavantage,yfinance
MARKET_DATA_HTTP_TIMEOUT_SECONDS=20
MARKET_DATA_CACHE_ENABLED=true
MARKET_DATA_CACHE_TTL_INTRADAY_SECONDS=300
MARKET_DATA_CACHE_TTL_DAILY_SECONDS=1800
MARKET_DATA_RETRY_ATTEMPTS=2
MARKET_DATA_RETRY_BACKOFF_SECONDS=0.75
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
BACKEND_URL=http://backend:8000
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
